{
  "/api/control": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/control": "/api"
    }
  },
  "/api/faturamento": {
    "target": "http://localhost:8082",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/faturamento/health": "/health",
      "^/api/faturamento": "/api"
    }
  },
  "/api/estoque": {
    "target": "http://localhost:8081",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/estoque/health": "/health",
      "^/api/estoque": "/api"
    }
  }
}